{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jourplaneraren",
  "account_id": "7a8e6db3082a866ded1d858dd40d495a",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node scripts/build.mjs" },
  "vars": { "ALLOWED_EMAIL": "ellinor.mauritzon@gmail.com" },
  "env": {
    "local": {
      "name": "jourplaneraren-local",
      "vars": { "ALLOWED_EMAIL": "demo@example.com" },
      "access": { "dev": { "aud": "local-demo", "identity": { "email": "demo@example.com" } } }
    }
  }
}
